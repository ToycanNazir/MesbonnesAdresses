{
  "name": "mes-bonnes-adresses",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test -c android.emu.release",
    "test:e2e:ios": "detox test -c ios.sim.release",
    "test:e2e:build": "detox build -c android.emu.release",
    "test:e2e:build:ios": "detox build -c ios.sim.release",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "storybook": "storybook dev"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.4.8",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.4.9",
    "expo": "~54.0.13",
    "expo-camera": "^17.0.8",
    "expo-image-picker": "^17.0.8",
    "expo-location": "^19.0.7",
    "expo-status-bar": "~3.0.8",
    "firebase": "^12.4.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "^4.1.3",
    "react-native-screens": "^4.16.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/datetimepicker": "^8.5.0",
    "@react-native-community/slider": "^5.1.0",
    "@storybook/react-native": "^9.1.4",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "detox": "^20.44.0",
    "jest-circus": "^30.2.0",
    "jest-expo": "^54.0.12",
    "react-native-safe-area-context": "^5.6.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
